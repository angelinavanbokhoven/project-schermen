<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Treinscherm (GSM)</title>
</head>

<body class="min-h-screen bg-slate-900 flex items-start justify-center p-4">
  <!-- Phone frame -->
  <div class="w-full max-w-sm rounded-3xl bg-slate-950 p-3 shadow-2xl ring-1 ring-white/10">
    <!-- Screen -->
    <div class="rounded-2xl bg-gradient-to-b from-blue-900 to-blue-800 p-3 text-white">

      <!-- Top header -->
      <div class="flex items-start gap-3">
        <div class="flex-1 rounded-xl bg-blue-700/70 px-3 py-2 ring-1 ring-white/10">
          <div class="text-[11px] uppercase tracking-wider text-white/80">Trein</div>
          <div class="text-base font-semibold leading-tight">{IC 4510} → BRUSSEL / BRUXELLES / BRÜSSEL</div>
          <div class="mt-1 text-xs text-white/80">Vertrek / Départ / Abfahrt</div>
          <div class="flex items-baseline gap-2">
            <span class="text-xl font-bold">14:30</span>
            <span class="text-sm font-bold text-red-300">+5</span>
          </div>
          <div class="mt-1 text-xs text-white/80">
            Volgende halte / Prochaine / Nächster: <span class="font-semibold text-white">Leuven</span>
          </div>
        </div>

        <div class="w-28 shrink-0 space-y-2">
          <div class="rounded-xl bg-blue-700/70 p-3 text-center ring-1 ring-white/10">
            <div class="text-[11px] uppercase tracking-wider text-white/80">Tijd</div>
            <div class="text-xl font-bold tabular-nums">14:15</div>
            <div class="text-xs font-semibold text-white/70">:01</div>
          </div>

          <div class="rounded-xl bg-blue-700/70 p-3 text-center ring-1 ring-white/10">
            <div class="text-[11px] uppercase tracking-wider text-white/80">Spoor</div>
            <div class="text-3xl font-black">7</div>
            <div class="text-[11px] text-white/70">Voie / Gleis</div>
          </div>
        </div>
      </div>

      <!-- List -->
      <div class="mt-3 space-y-2">
        <!-- Row helper: time | code | destination | delay -->
        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">14:45</div>
          <div class="text-xs font-semibold text-white/90">{S 5502}</div>
          <div class="flex-1 text-sm font-medium truncate">Genk / Gand / Genk</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">15:00</div>
          <div class="text-xs font-semibold text-white/90">{L 4980}</div>
          <div class="flex-1 text-sm font-medium truncate">Landen / Landen / Landen</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">15:15</div>
          <div class="text-xs font-semibold text-white/90">{IC 2909}</div>
          <div class="flex-1 text-sm font-medium truncate">Luik / Liège / Lüttich</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">15:45</div>
          <div class="text-xs font-semibold text-white/90">{L 4981}</div>
          <div class="flex-1 text-sm font-medium truncate">Tienen / Tirlemont / Thienen</div>
          <div class="text-sm font-bold text-red-300 tabular-nums">+8</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">16:00</div>
          <div class="text-xs font-semibold text-white/90">{L 7832}</div>
          <div class="flex-1 text-sm font-medium truncate">Aarschot / Aerschot / Aerschot</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">16:15</div>
          <div class="text-xs font-semibold text-white/90">{IC 2406}</div>
          <div class="flex-1 text-sm font-medium truncate">Brussel-Centraal / Bruxelles-Central</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">16:30</div>
          <div class="text-xs font-semibold text-white/90">{S 5503}</div>
          <div class="flex-1 text-sm font-medium truncate">Ottignies / Ottignies / Ottignies</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">16:45</div>
          <div class="text-xs font-semibold text-white/90">{IC 2910}</div>
          <div class="flex-1 text-sm font-medium truncate">Luik / Liège / Lüttich</div>
          <div class="text-sm font-bold text-red-300 tabular-nums">+10</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">17:00</div>
          <div class="text-xs font-semibold text-white/90">{IC 5137}</div>
          <div class="flex-1 text-sm font-medium truncate">Hasselt / Hasselt / Hasselt</div>
        </div>

        <div class="flex items-center gap-3 rounded-xl bg-blue-600/40 px-3 py-2 ring-1 ring-white/10">
          <div class="w-12 text-sm font-bold tabular-nums">17:15</div>
          <div class="text-xs font-semibold text-white/90">{IC 2021}</div>
          <div class="flex-1 text-sm font-medium truncate">Kortrijk / Courtrai / Kortrijk</div>
        </div>
      </div>

      <!-- Bottom icons bar (simple) -->
      <div class="mt-4 rounded-xl bg-blue-950/40 p-2 ring-1 ring-white/10">
        <div class="grid grid-cols-6 gap-2 text-center text-[11px] font-semibold text-white/90">
          <div class="rounded-lg bg-white/10 py-2">1</div>
          <div class="rounded-lg bg-white/10 py-2">2</div>
          <div class="rounded-lg bg-white/10 py-2">WC</div>
          <div class="rounded-lg bg-white/10 py-2">♿</div>
          <div class="rounded-lg bg-white/10 py-2">🚲</div>
          <div class="rounded-lg bg-white/10 py-2">i</div>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
